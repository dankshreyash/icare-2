{
  "redirects": [
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/services.html", "destination": "/what-we-do", "permanent": true },
    { "source": "/services", "destination": "/what-we-do", "permanent": true },
    { "source": "/evolution.html", "destination": "/about", "permanent": true },
    { "source": "/evolution", "destination": "/about", "permanent": true },
    { "source": "/network.html", "destination": "/track-record", "permanent": true },
    { "source": "/network", "destination": "/track-record", "permanent": true },
    { "source": "/gsirf.html", "destination": "/track-record", "permanent": true },
    { "source": "/gsirf", "destination": "/track-record", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/tools", "destination": "/tools-and-initiatives", "permanent": true },
    { "source": "/team", "destination": "/leadership-and-team", "permanent": true },
    { "source": "/leadership", "destination": "/leadership-and-team", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
